# Copy to .env.local (Expo loads it automatically) and restart the dev server.
# Expo only inlines variables prefixed with EXPO_PUBLIC_.

# Leave this UNSET to run fully mocked — the app works with no backend at all.
#
# Set it to go live. Use your machine's LAN IP, not localhost: a phone or the
# Android emulator cannot reach the host's loopback address.
#   macOS: ipconfig getifaddr en0
#
# Interim: this points at the AI Engine (real voice + multilingual replies, no
# receipts). It becomes the UCXP Runtime's URL once that exists — see PLAN.md §7.
# EXPO_PUBLIC_API_URL=http://192.168.1.5:8080

# Force mocks even when a URL is set — useful for offline demos.
# EXPO_PUBLIC_FORCE_MOCK=1
