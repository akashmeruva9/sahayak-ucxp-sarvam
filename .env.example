# =============================================================================
# Sahayak AI Engine — copy to .env and fill in
# =============================================================================

# --- Credentials -------------------------------------------------------------
SARVAM_API_KEY=your-sarvam-subscription-key
SARVAM_BASE_URL=https://api.sarvam.ai
# For a keyless local run against tools/mock_sarvam.py:
#   SARVAM_BASE_URL=http://127.0.0.1:8099
#   SARVAM_API_KEY=mock

# --- Transport ---------------------------------------------------------------
SARVAM_REQUEST_TIMEOUT=30
SARVAM_CONNECT_TIMEOUT=10
SARVAM_MAX_CONNECTIONS=50

# --- Retries (total attempts = MAX_RETRIES + 1) ------------------------------
SARVAM_MAX_RETRIES=2
SARVAM_RETRY_BASE_DELAY=0.5
SARVAM_RETRY_MAX_DELAY=8
SARVAM_RETRY_JITTER=0.25

# --- Models ------------------------------------------------------------------
SARVAM_STT_MODEL=saarika:v2.5
SARVAM_STT_TRANSLATE_MODEL=saaras:v2.5
SARVAM_TRANSLATE_MODEL=sarvam-translate:v1
# sarvam-105b (reliable) or sarvam-30b (cheaper, often runs out of budget mid-thought)
SARVAM_LLM_MODEL=sarvam-105b
SARVAM_TTS_MODEL=bulbul:v2

# --- Endpoints (override only if Sarvam moves them) --------------------------
SARVAM_STT_ENDPOINT=/speech-to-text
SARVAM_STT_TRANSLATE_ENDPOINT=/speech-to-text-translate
SARVAM_TRANSLATE_ENDPOINT=/translate
SARVAM_TRANSLITERATE_ENDPOINT=/transliterate
SARVAM_LID_ENDPOINT=/text-lid
SARVAM_LLM_ENDPOINT=/v1/chat/completions
SARVAM_TTS_ENDPOINT=/text-to-speech

# --- LLM behaviour -----------------------------------------------------------
SARVAM_LLM_TEMPERATURE=0.3
SARVAM_LLM_TOP_P=1.0
# These are REASONING models: the budget covers thinking AND the answer.
# Too low => content comes back empty. Your tier caps this (starter: 4096).
SARVAM_LLM_MAX_TOKENS=4096
SARVAM_LLM_MAX_TOKENS_CEILING=4096
SARVAM_LLM_RETRY_ON_TRUNCATION=true
# low | medium | high — thinking cannot be turned off
# SARVAM_LLM_REASONING_EFFORT=low
SARVAM_LLM_WIKI_GROUNDING=false
SARVAM_LLM_MAX_HISTORY_TURNS=12

# --- Translation -------------------------------------------------------------
SARVAM_TRANSLATE_MODE=formal
SARVAM_TRANSLATE_MAX_CHARS=1500

# --- Voice -------------------------------------------------------------------
# Voices are model-specific — change model and speaker together.
#   bulbul:v2  female: anushka, manisha, vidya, arya | male: abhilash, karun, hitesh
#   bulbul:v3  female: priya, ritu, neha, pooja, …   | male: aditya, rahul, rohan, …
SARVAM_TTS_SPEAKER=anushka
SARVAM_TTS_PITCH=0.0
SARVAM_TTS_PACE=1.0
SARVAM_TTS_LOUDNESS=1.0
SARVAM_TTS_SAMPLE_RATE=22050
SARVAM_TTS_MAX_CHARS=1000
SARVAM_TTS_PREPROCESSING=true

# --- Languages ---------------------------------------------------------------
AI_ENGINE_DEFAULT_LANGUAGE=en-IN
AI_ENGINE_PIVOT_LANGUAGE=en-IN
AI_ENGINE_SUPPORTED_LANGUAGES=en-IN,hi-IN,bn-IN,gu-IN,kn-IN,ml-IN,mr-IN,od-IN,pa-IN,ta-IN,te-IN

# --- Pipeline behaviour ------------------------------------------------------
AI_ENGINE_GRACEFUL_DEGRADATION=true
AI_ENGINE_SKIP_REDUNDANT_TRANSLATION=true

# --- Prompts -----------------------------------------------------------------
# AI_ENGINE_PROMPTS_DIR=/abs/path/to/your/prompts
AI_ENGINE_DEFAULT_PROMPT=system
AI_ENGINE_PROMPT_HOT_RELOAD=false

# --- Logging -----------------------------------------------------------------
AI_ENGINE_LOG_LEVEL=INFO
AI_ENGINE_LOG_JSON=false
# AI_ENGINE_LOG_FILE=logs/ai_engine.log

# --- Engine HTTP surface -----------------------------------------------------
AI_ENGINE_HOST=0.0.0.0
AI_ENGINE_PORT=8080
AI_ENGINE_TITLE=Sahayak AI Engine

# --- Voice-call channel: Sarvam Samvaad Advanced Tool (PLAN §11) -------------
# Public https base for this runtime (e.g. an ngrok URL). GET /agent/tool-spec
# uses it to emit an absolute tool URL to paste into the Samvaad dashboard.
# UCXP_PUBLIC_BASE_URL=https://your-tunnel.ngrok-free.app
# Optional shared secret. If set, /agent/resolve requires Samvaad to send
# `Authorization: Bearer <this>`. Leave unset to keep the tool open (demo).
# UCXP_AGENT_TOOL_TOKEN=
