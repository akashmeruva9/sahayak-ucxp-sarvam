{
  "ucxp_version": "0.1",

  "business": {
    "id": "apollo",
    "name": "Apollo",
    "category": "Healthcare",
    "glyph": "🩺",
    "color": "#00A0B0",
    "languages": ["en-IN", "hi-IN", "te-IN", "ta-IN"]
  },

  "routing": {
    "aliases": ["apollo", "apollo clinic", "apollo hospital", "अपोलो", "అపోలో", "அப்பல்லோ"],
    "domains": ["doctor", "appointment", "clinic", "hospital", "consultation", "checkup", "physician", "slot"]
  },

  "auth": {
    "type": "none",
    "identity_fields": ["phone"]
  },

  "capabilities": [
    {
      "id": "find_doctor",
      "description": "Find available doctors of a given speciality near the customer.",
      "examples": [
        "I need a skin doctor",
        "find me a physician nearby",
        "मुझे डॉक्टर चाहिए",
        "నాకు డాక్టర్ కావాలి",
        "எனக்கு மருத்துவர் வேண்டும்"
      ],
      "required_inputs": [
        {
          "name": "speciality",
          "type": "string",
          "prompt": "What kind of doctor do you need — general physician, dermatologist, paediatrician?",
          "optional": false
        },
        {
          "name": "city",
          "type": "string",
          "prompt": "Which city are you in?",
          "default_from": "context.last_city",
          "optional": true
        }
      ],
      "rules": [],
      "confirm": false,
      "action": "search_doctors",
      "response": "{{result.doctor_name}} ({{result.speciality}}) is available at {{result.clinic}}. The next slot is {{result.next_slot}}.",
      "receipt": {
        "label": "{{result.doctor_name}} · {{result.next_slot}}",
        "tone": "info"
      }
    },
    {
      "id": "book_appointment",
      "description": "Book a consultation slot with a doctor.",
      "examples": [
        "book me an appointment tomorrow",
        "schedule a consultation",
        "कल का अपॉइंटमेंट बुक करो",
        "రేపు అపాయింట్‌మెంట్ బుక్ చేయండి"
      ],
      "required_inputs": [
        {
          "name": "speciality",
          "type": "string",
          "prompt": "Which speciality should I book — general physician, dermatologist, paediatrician?",
          "default_from": "context.last_speciality",
          "optional": false
        },
        {
          "name": "when",
          "type": "string",
          "prompt": "When would you like the appointment — today, tomorrow, or a specific date?",
          "optional": false
        }
      ],
      "rules": [
        {
          "id": "no_slots",
          "when": "result.slots_available == 0",
          "deny": "There are no slots left for that day. I can look at the next available date instead."
        }
      ],
      "confirm": true,
      "action": "create_appointment",
      "response": "Booked. {{result.doctor_name}} will see you at {{result.slot_time}} at {{result.clinic}}.",
      "receipt": {
        "label": "Booking {{result.booking_ref}} · {{result.slot_time}}",
        "tone": "success"
      }
    },
    {
      "id": "cancel_appointment",
      "description": "Cancel an existing appointment booking.",
      "examples": [
        "cancel my appointment",
        "I can't make it to the doctor",
        "मेरा अपॉइंटमेंट कैंसिल कर दो",
        "నా అపాయింట్‌మెంట్ రద్దు చేయండి"
      ],
      "required_inputs": [
        {
          "name": "booking_ref",
          "type": "string",
          "prompt": "What's your booking reference?",
          "default_from": "context.last_booking_ref",
          "optional": false
        }
      ],
      "rules": [],
      "confirm": true,
      "action": "cancel_appointment",
      "response": "Your appointment {{booking_ref}} is cancelled. {{result.refund_note}}",
      "receipt": {
        "label": "Cancelled {{booking_ref}}",
        "tone": "warning"
      }
    }
  ],

  "endpoints": [
    {
      "id": "search_doctors",
      "method": "GET",
      "url": "{{mock_base}}/apollo/doctors?speciality={{speciality}}&city={{city}}",
      "headers": {},
      "body": null,
      "timeout_s": 5
    },
    {
      "id": "create_appointment",
      "method": "POST",
      "url": "{{mock_base}}/apollo/appointments",
      "headers": {},
      "body": { "speciality": "{{speciality}}", "when": "{{when}}" },
      "timeout_s": 5
    },
    {
      "id": "cancel_appointment",
      "method": "POST",
      "url": "{{mock_base}}/apollo/appointments/{{booking_ref}}/cancel",
      "headers": {},
      "body": {},
      "timeout_s": 5
    }
  ],

  "knowledge": [
    {
      "id": "consultation_fee",
      "text": "A general physician consultation is ₹600; speciality consultations range from ₹800 to ₹1200."
    },
    {
      "id": "cancellation_policy",
      "text": "Appointments cancelled more than 4 hours in advance are fully refunded."
    }
  ],

  "escalation": {
    "when": ["rule_denied", "action_failed", "user_asks_human"],
    "message": "I'll have an Apollo coordinator call you to sort this out.",
    "action": "create_escalation_ticket"
  }
}
