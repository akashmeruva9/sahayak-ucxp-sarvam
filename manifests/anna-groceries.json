{
  "ucxp_version": "0.1",
  "business": {
    "id": "anna-groceries",
    "name": "Anna Groceries",
    "category": "Grocery",
    "glyph": "🛒",
    "color": "#E0A800",
    "languages": [
      "en-IN",
      "hi-IN",
      "te-IN",
      "ta-IN"
    ]
  },
  "routing": {
    "aliases": [
      "anna",
      "anna groceries",
      "అన్న గ్రోసరీస్",
      "अन्ना ग्रोसरीज़"
    ],
    "domains": [
      "order",
      "rice",
      "dal",
      "oil",
      "grocery",
      "reorder",
      "delivery"
    ]
  },
  "auth": {
    "type": "none",
    "identity_fields": [
      "order_id"
    ]
  },
  "capabilities": [
    {
      "id": "track_order",
      "description": "Tell the customer where their order currently is and when it will arrive.",
      "examples": [
        "where is my order",
        "has my order shipped",
        "track order 1001",
        "मेरा ऑर्डर कहाँ है",
        "నా ఆర్డర్ ఎక్కడ ఉంది",
        "என் ஆர்டர் எங்கே இருக்கிறது"
      ],
      "required_inputs": [
        {
          "name": "order_id",
          "type": "string",
          "prompt": "What's your order number?",
          "default_from": "context.last_order_id",
          "optional": false
        }
      ],
      "rules": [],
      "confirm": false,
      "action": "get_order",
      "response": "Your order {{order_id}} — {{result.item}} — is {{result.status}}. Total ₹{{result.amount}}. Expected by {{result.eta}}.",
      "receipt": {
        "label": "{{result.status}} · arriving {{result.eta}}",
        "tone": "success"
      }
    },
    {
      "id": "reorder",
      "description": "Repeat a previous order for the customer.",
      "examples": [
        "order the same again",
        "repeat my last order",
        "वही दोबारा भेज दो",
        "మళ్ళీ అదే పంపండి",
        "அதே மீண்டும் அனுப்பு"
      ],
      "required_inputs": [
        {
          "name": "order_id",
          "type": "string",
          "prompt": "What's your order number?",
          "default_from": "context.last_order_id",
          "optional": false
        }
      ],
      "rules": [],
      "confirm": true,
      "action": "create_reorder",
      "response": "Reordered {{result.item}} for ₹{{result.amount}}. New order {{result.new_order_id}}, arriving {{result.eta}}.",
      "receipt": {
        "label": "Reordered · {{result.new_order_id}}",
        "tone": "success"
      }
    },
    {
      "id": "cancel_order",
      "description": "Cancel an order that has not yet been delivered.",
      "examples": [
        "cancel my order",
        "I don't want this order any more",
        "मेरा ऑर्डर कैंसल करो",
        "నా ఆర్డర్ రద్దు చేయండి",
        "என் ஆர்டரை ரத்து செய்"
      ],
      "required_inputs": [
        {
          "name": "order_id",
          "type": "string",
          "prompt": "What's your order number?",
          "default_from": "context.last_order_id",
          "optional": false
        }
      ],
      "rules": [
        {
          "id": "already_delivered",
          "when": "result.status == 'delivered'",
          "deny": "Order {{order_id}} has already been delivered, so it can't be cancelled. I can start a return instead."
        }
      ],
      "confirm": true,
      "action": "cancel_order",
      "response": "Done — order {{order_id}} is cancelled. Any amount paid is refunded within {{result.refund_eta_days}} days.",
      "receipt": {
        "label": "Cancelled · ref {{result.cancellation_ref}}",
        "tone": "warning"
      }
    }
  ],
  "endpoints": [
    {
      "id": "cancel_order",
      "method": "POST",
      "url": "{{mock_base}}/anna-groceries/orders/{{order_id}}/cancel",
      "headers": {},
      "body": null,
      "timeout_s": 5
    },
    {
      "id": "create_reorder",
      "method": "POST",
      "url": "{{mock_base}}/anna-groceries/orders/{{order_id}}/reorder",
      "headers": {},
      "body": null,
      "timeout_s": 5
    },
    {
      "id": "get_order",
      "method": "GET",
      "url": "{{mock_base}}/anna-groceries/orders/{{order_id}}",
      "headers": {},
      "body": null,
      "timeout_s": 5
    }
  ],
  "knowledge": [
    {
      "id": "return_policy",
      "text": "Perishable items can be returned only if damaged on delivery and reported within 2 hours."
    },
    {
      "id": "minimum_order",
      "text": "Minimum order value is 200 rupees. Delivery is free above 500 rupees."
    },
    {
      "id": "freshness",
      "text": "Vegetables and staples are sourced daily from the local market."
    },
    {
      "id": "delivery",
      "text": "Same-day delivery for orders placed before 2 PM, next-day otherwise."
    }
  ],
  "escalation": {
    "when": [
      "rule_denied",
      "action_failed",
      "user_asks_human"
    ],
    "message": "I'm handing this to a human agent from Anna Groceries — they'll call you back within 2 hours.",
    "action": "create_escalation_ticket"
  }
}
