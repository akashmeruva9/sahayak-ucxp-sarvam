{
  "ucxp_version": "0.1",
  "business": "Anna Groceries",
  "business_id": "anna-groceries",
  "category": "Food & Beverage",
  "profile": {
    "tagline": "Staples and pulses for the month, at honest prices.",
    "description": "Anna Groceries sells household staples in bulk - rice, cooking oil and pulses - delivered to homes across the city.",
    "support_email": "support@annagroceries.in",
    "support_phone": "+91 422 435 7700",
    "website": "https://anna-groceries.myshopify.com",
    "hours": "Mon-Sun 07:00-21:00 IST",
    "city": "Coimbatore"
  },
  "primary_language": "ta-IN",
  "languages": [
    "ta-IN",
    "en-IN",
    "hi-IN",
    "te-IN",
    "kn-IN",
    "ml-IN"
  ],
  "data_source": {
    "type": "shopify",
    "store_subdomain": "anna-groceries.myshopify.com",
    "credential_ref": "vault://anna-groceries",
    "reads": [
      "read_orders",
      "read_products"
    ],
    "pii_available": false
  },
  "identify_by": "order_number",
  "capabilities": [
    {
      "name": "track_order",
      "source": "shopify_default",
      "endpoint": "/connectors/shopify/orders/{order_id}",
      "method": "GET",
      "description": "Live status for \"Where is my order?\"",
      "parameters": {
        "path": [
          {
            "name": "order_id",
            "type": "string",
            "required": true,
            "example": "<order_number>",
            "description": "Shopify order number. Customers are identified by order number, never by name -- see identify_by."
          }
        ]
      },
      "request": {
        "headers": {
          "X-Shopify-Access-Token": "{{credential_ref}}"
        }
      },
      "response": {
        "example": {
          "order_id": "<order number supplied by the customer>",
          "status": "<live fulfilment status from Shopify>",
          "payment": "<live payment status>",
          "amount": "<order total>",
          "currency": "INR",
          "items": [
            {
              "title": "<line item>",
              "qty": 1
            }
          ]
        },
        "mapping": {
          "status": "$.displayFulfillmentStatus",
          "amount": "$.totalPriceSet.shopMoney.amount",
          "currency": "$.totalPriceSet.shopMoney.currencyCode"
        }
      },
      "errors": [
        {
          "code": "404",
          "meaning": "Order not found",
          "customer_message": "Sorry, we couldn't find that order number"
        },
        {
          "code": "401",
          "meaning": "Authentication failed",
          "customer_message": "I'm having trouble reaching the store right now"
        },
        {
          "code": "500",
          "meaning": "Server error",
          "customer_message": "Something went wrong on our side. Please try again shortly"
        }
      ],
      "notes": "Auto-configured from Shopify store anna-groceries."
    },
    {
      "name": "refund",
      "source": "shopify_default",
      "endpoint": "/connectors/shopify/orders/{order_id}/refund",
      "method": "POST",
      "description": "Initiate and track refunds",
      "parameters": {
        "path": [
          {
            "name": "order_id",
            "type": "string",
            "required": true,
            "example": "<order_number>",
            "description": "Shopify order number. Customers are identified by order number, never by name -- see identify_by."
          }
        ]
      },
      "request": {
        "headers": {
          "X-Shopify-Access-Token": "{{credential_ref}}"
        },
        "body": {
          "order_id": "<order number supplied by the customer>",
          "reason": "<reason code, e.g. damaged_on_arrival>"
        }
      },
      "response": {
        "example": {
          "refund_id": "<refund id returned by Shopify>",
          "order_id": "<order number supplied by the customer>",
          "status": "<refund status>",
          "amount": "<refunded amount>",
          "currency": "INR",
          "eta_days": 5
        },
        "mapping": {
          "status": "$.displayFulfillmentStatus",
          "amount": "$.totalPriceSet.shopMoney.amount",
          "currency": "$.totalPriceSet.shopMoney.currencyCode"
        }
      },
      "errors": [
        {
          "code": "404",
          "meaning": "Order not found",
          "customer_message": "Sorry, we couldn't find that order number"
        },
        {
          "code": "401",
          "meaning": "Authentication failed",
          "customer_message": "I'm having trouble reaching the store right now"
        },
        {
          "code": "500",
          "meaning": "Server error",
          "customer_message": "Something went wrong on our side. Please try again shortly"
        }
      ],
      "notes": "Auto-configured from Shopify store anna-groceries."
    }
  ],
  "policies": {
    "return_policy": "Sealed staples can be returned within 48 hours of delivery. Opened or partially used food items are non-returnable.",
    "refund_policy": "Refunds for damaged or short-supplied items are issued within 3 working days of the report.",
    "shipping_policy": "Same-city delivery next day for orders placed before 4 PM. Free above Rs.500, Rs.40 below.",
    "warranty": "Food staples carry no warranty. Quality complaints raised within 24 hours of delivery are replaced or refunded."
  },
  "faq": [
    {
      "q": "Where is my order?",
      "a": "Share your order number and I'll check the live status with the store."
    },
    {
      "q": "When will my groceries arrive?",
      "a": "Orders placed before 4 PM are delivered the next day within the city."
    },
    {
      "q": "Can I return groceries?",
      "a": "Sealed staples can be returned within 48 hours of delivery. Opened food items cannot be returned."
    },
    {
      "q": "What if an item is damaged or leaking?",
      "a": "Report it within 24 hours with your order number and we replace the item or refund it in full."
    },
    {
      "q": "Is there a minimum order?",
      "a": "Delivery is free above Rs.500. Below that a Rs.40 delivery fee applies."
    }
  ],
  "sla": {
    "first_response": "48h",
    "resolution": "30d",
    "auto_escalate": true
  },
  "escalation": [
