          }
        ]
      },
      "request": {
        "headers": {
          "X-Shopify-Access-Token": "{{credential_ref}}"
        }
      },
      "response": {
        "example": {
          "order_id": "<order number supplied by the customer>",
          "status": "<live fulfilment status from Shopify>",
          "payment": "<live payment status>",
          "amount": "<order total>",
          "currency": "INR",
          "items": [
            {
              "title": "<line item>",
              "qty": 1
            }
          ]
        },
        "mapping": {
          "status": "$.displayFulfillmentStatus",
          "amount": "$.totalPriceSet.shopMoney.amount",
          "currency": "$.totalPriceSet.shopMoney.currencyCode"
        }
      },
