{
  "ucxp_version": "0.1",

  "business": {
    "id": "flipkart",
    "name": "Flipkart",
    "category": "Shopping",
    "glyph": "🛍",
    "color": "#2874F0",
    "languages": ["en-IN", "hi-IN", "te-IN", "ta-IN"]
  },

  "routing": {
    "aliases": ["flipkart", "flip kart", "फ्लिपकार्ट", "ఫ్లిప్‌కార్ట్", "ஃபிளிப்கார்ட்"],
    "domains": ["order", "delivery", "package", "parcel", "shipment", "refund", "return", "cancel order"]
  },

  "auth": {
    "type": "none",
    "identity_fields": ["phone"]
  },

  "capabilities": [
    {
      "id": "track_order",
      "description": "Find where a customer's order currently is and when it will arrive.",
      "examples": [
        "where is my order",
        "track my package",
        "मेरा ऑर्डर कहाँ है",
        "నా ఆర్డర్ ఎక్కడ ఉంది",
        "என் ஆர்டர் எங்கே"
      ],
      "required_inputs": [
        {
          "name": "order_id",
          "type": "string",
          "prompt": "What's your order ID? It looks like OD1234567890.",
          "default_from": "context.last_order_id",
          "optional": false
        }
      ],
      "rules": [],
      "confirm": false,
      "action": "get_order_status",
      "response": "Your order {{order_id}} ({{result.item}}) is {{result.status}} and arrives {{result.eta}}.",
      "receipt": {
        "label": "Arriving {{result.eta}}",
        "tone": "success"
      }
    },
    {
      "id": "cancel_order",
      "description": "Cancel an order that has not been delivered yet.",
      "examples": [
        "cancel my order",
        "I don't want this order anymore",
        "मेरा ऑर्डर कैंसिल कर दो",
        "నా ఆర్డర్ రద్దు చేయండి"
      ],
      "required_inputs": [
        {
          "name": "order_id",
          "type": "string",
          "prompt": "Which order should I cancel? Please share the order ID.",
          "default_from": "context.last_order_id",
          "optional": false
        }
      ],
      "rules": [
        {
          "id": "already_delivered",
          "when": "result.status == 'delivered'",
          "deny": "This order has already been delivered, so it can't be cancelled. I can start a return instead."
        }
      ],
      "confirm": true,
      "action": "cancel_order",
      "response": "Done — order {{order_id}} is cancelled. {{result.refund_note}}",
      "receipt": {
        "label": "Cancelled · refund {{result.refund_ref}}",
        "tone": "warning"
      }
    },
    {
      "id": "request_refund",
      "description": "Request a refund for a delivered order that the customer is unhappy with.",
      "examples": [
        "I want a refund",
        "this product is damaged, refund it",
        "मुझे रिफंड चाहिए",
        "எனக்கு பணத்தை திரும்ப வேண்டும்"
      ],
      "required_inputs": [
        {
          "name": "order_id",
          "type": "string",
          "prompt": "What's the order ID you'd like refunded?",
          "default_from": "context.last_order_id",
          "optional": false
        },
        {
          "name": "reason",
          "type": "string",
          "prompt": "What went wrong with the item?",
          "optional": true
        }
      ],
      "rules": [
        {
          "id": "refund_window",
          "when": "result.days_since_delivery > 7",
          "deny": "Refunds are only available within 7 days of delivery. I can raise a support ticket for you instead."
        }
      ],
      "confirm": false,
      "action": "create_refund",
      "response": "Refund raised for order {{order_id}}. {{result.amount}} will reach your account in {{result.eta_days}} business days.",
      "receipt": {
        "label": "Refund {{result.refund_ref}} · {{result.amount}}",
        "tone": "success"
      }
    }
  ],

  "endpoints": [
    {
      "id": "get_order_status",
      "method": "GET",
      "url": "{{mock_base}}/flipkart/orders/{{order_id}}",
      "headers": {},
      "body": null,
      "timeout_s": 5
    },
    {
      "id": "cancel_order",
      "method": "POST",
      "url": "{{mock_base}}/flipkart/orders/{{order_id}}/cancel",
      "headers": {},
      "body": {},
      "timeout_s": 5
    },
    {
      "id": "create_refund",
      "method": "POST",
      "url": "{{mock_base}}/flipkart/orders/{{order_id}}/refund",
      "headers": {},
      "body": { "reason": "{{reason}}" },
      "timeout_s": 5
    }
  ],

  "knowledge": [
    {
      "id": "refund_policy",
      "text": "Refunds are processed within 5-7 business days of approval and are credited to the original payment method."
    },
    {
      "id": "delivery_window",
      "text": "Standard delivery is 3-5 days; orders in transit can be tracked with the order ID."
    }
  ],

  "escalation": {
    "when": ["rule_denied", "action_failed", "user_asks_human"],
    "message": "I'm handing this to a human agent — they'll call you within 2 hours.",
    "action": "create_escalation_ticket"
  }
}
