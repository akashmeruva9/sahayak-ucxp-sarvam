{
  "ucxp_version": "0.1",
  "business": "Meena Kitchen Store",
  "business_id": "meena-kitchen-store",
  "category": "Home & Living",
  "profile": {
    "tagline": "Kitchen appliances and cookware that last.",
    "description": "Meena Kitchen Store sells mixer grinders, pressure cookers, induction cooktops, tawas and flasks from trusted Indian brands.",
    "support_email": "support@meenakitchen.in",
    "support_phone": "+91 80 4655 9100",
    "website": "https://meena-kitchen-store.myshopify.com",
    "hours": "Mon-Sat 10:00-19:30 IST",
    "city": "Bengaluru"
  },
  "primary_language": "kn-IN",
  "languages": [
    "kn-IN",
    "en-IN",
    "hi-IN",
    "ta-IN",
    "te-IN",
    "ml-IN",
    "mr-IN"
  ],
  "data_source": {
    "type": "shopify",
    "store_subdomain": "meena-kitchen-store.myshopify.com",
    "credential_ref": "vault://meena-kitchen-store",
    "reads": [
      "read_orders",
      "read_products"
    ],
    "pii_available": false
  },
  "identify_by": "order_number",
  "capabilities": [
    {
      "name": "track_order",
      "source": "shopify_default",
      "endpoint": "/connectors/shopify/orders/{order_id}",
      "method": "GET",
      "description": "Live status for \"Where is my order?\"",
      "parameters": {
        "path": [
          {
            "name": "order_id",
            "type": "string",
            "required": true,
            "example": "<order_number>",
            "description": "Shopify order number. Customers are identified by order number, never by name -- see identify_by."
          }
        ]
      },
      "request": {
        "headers": {
          "X-Shopify-Access-Token": "{{credential_ref}}"
        }
      },
      "response": {
        "example": {
          "order_id": "<order number supplied by the customer>",
          "status": "<live fulfilment status from Shopify>",
          "payment": "<live payment status>",
          "amount": "<order total>",
          "currency": "INR",
          "items": [
            {
              "title": "<line item>",
              "qty": 1
            }
          ]
        },
        "mapping": {
          "status": "$.displayFulfillmentStatus",
          "amount": "$.totalPriceSet.shopMoney.amount",
          "currency": "$.totalPriceSet.shopMoney.currencyCode"
        }
      },
      "errors": [
        {
          "code": "404",
          "meaning": "Order not found",
          "customer_message": "Sorry, we couldn't find that order number"
        },
        {
          "code": "401",
          "meaning": "Authentication failed",
          "customer_message": "I'm having trouble reaching the store right now"
        },
        {
          "code": "500",
          "meaning": "Server error",
          "customer_message": "Something went wrong on our side. Please try again shortly"
        }
      ],
      "notes": "Auto-configured from Shopify store meena-kitchen-store."
    },
    {
      "name": "refund",
      "source": "shopify_default",
      "endpoint": "/connectors/shopify/orders/{order_id}/refund",
      "method": "POST",
      "description": "Initiate and track refunds",
      "parameters": {
        "path": [
          {
            "name": "order_id",
            "type": "string",
            "required": true,
            "example": "<order_number>",
            "description": "Shopify order number. Customers are identified by order number, never by name -- see identify_by."
          }
        ]
      },
      "request": {
        "headers": {
          "X-Shopify-Access-Token": "{{credential_ref}}"
        },
        "body": {
          "order_id": "<order number supplied by the customer>",
          "reason": "<reason code, e.g. damaged_on_arrival>"
        }
      },
      "response": {
        "example": {
          "refund_id": "<refund id returned by Shopify>",
          "order_id": "<order number supplied by the customer>",
          "status": "<refund status>",
          "amount": "<refunded amount>",
          "currency": "INR",
          "eta_days": 5
        },
        "mapping": {
          "status": "$.displayFulfillmentStatus",
          "amount": "$.totalPriceSet.shopMoney.amount",
          "currency": "$.totalPriceSet.shopMoney.currencyCode"
        }
      },
      "errors": [
        {
          "code": "404",
          "meaning": "Order not found",
          "customer_message": "Sorry, we couldn't find that order number"
        },
        {
          "code": "401",
          "meaning": "Authentication failed",
          "customer_message": "I'm having trouble reaching the store right now"
        },
        {
          "code": "500",
          "meaning": "Server error",
          "customer_message": "Something went wrong on our side. Please try again shortly"
        }
      ],
      "notes": "Auto-configured from Shopify store meena-kitchen-store."
    }
  ],
  "policies": {
    "return_policy": "Unused appliances in original packaging with all accessories can be returned within 7 days of delivery.",
    "refund_policy": "Refunds reach the original payment method within 5 working days of the returned appliance passing inspection.",
    "shipping_policy": "Dispatch within 24-48 hours. Free shipping above Rs.999. Delivery in 3-5 working days across India.",
    "warranty": "Manufacturer warranty applies - typically 2 years on mixer grinders and 1 year on cooktops and cookers. Claims are raised with the brand service centre using the order number."
  },
  "faq": [
    {
      "q": "Where is my order?",
      "a": "Share your order number and I'll check the live status with the store."
    },
    {
      "q": "How long does delivery take?",
      "a": "Appliances are dispatched in 24-48 hours and delivered in 3-5 working days across India."
    },
    {
      "q": "Can I return an appliance?",
      "a": "Unused appliances in original packaging can be returned within 7 days of delivery."
    },
    {
      "q": "What warranty do appliances carry?",
      "a": "Mixer grinders, pressure cookers and induction cooktops carry the manufacturer's warranty - typically 1 to 2 years."
    },
    {
      "q": "Is installation or demo included?",
      "a": "Induction cooktops and mixer grinders come with a free demo call. No physical installation is required."
    }
  ],
