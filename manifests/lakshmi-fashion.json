{
  "ucxp_version": "0.1",
  "business": {
    "id": "lakshmi-fashion",
    "name": "Lakshmi Fashion",
    "category": "Fashion",
    "glyph": "👗",
    "color": "#C2185B",
    "languages": [
      "en-IN",
      "hi-IN",
      "te-IN",
      "ta-IN"
    ]
  },
  "routing": {
    "aliases": [
      "lakshmi",
      "lakshmi fashion",
      "లక్ష్మి ఫ్యాషన్",
      "लक्ष्मी फैशन"
    ],
    "domains": [
      "order",
      "saree",
      "kurta",
      "dress",
      "size",
      "exchange",
      "return"
    ]
  },
  "auth": {
    "type": "none",
    "identity_fields": [
      "order_id"
    ]
  },
  "capabilities": [
    {
      "id": "track_order",
      "description": "Tell the customer where their order currently is and when it will arrive.",
      "examples": [
        "where is my order",
        "has my order shipped",
        "track order 1001",
        "मेरा ऑर्डर कहाँ है",
        "నా ఆర్డర్ ఎక్కడ ఉంది",
        "என் ஆர்டர் எங்கே இருக்கிறது"
      ],
      "required_inputs": [
        {
          "name": "order_id",
          "type": "string",
          "prompt": "What's your order number?",
          "default_from": "context.last_order_id",
          "optional": false
        }
      ],
      "rules": [],
      "confirm": false,
      "action": "get_order",
      "response": "Your order {{order_id}} — {{result.item}} — is {{result.status}}. Total ₹{{result.amount}}. Expected by {{result.eta}}.",
      "receipt": {
        "label": "{{result.status}} · arriving {{result.eta}}",
        "tone": "success"
      }
    },
    {
      "id": "request_exchange",
      "description": "Arrange a size or product exchange for a delivered fashion order.",
      "examples": [
        "I need a different size",
        "this doesn't fit, exchange it",
        "मुझे दूसरा साइज़ चाहिए",
        "నాకు వేరే సైజ్ కావాలి",
        "எனக்கு வேறு அளவு வேண்டும்"
      ],
      "required_inputs": [
        {
          "name": "order_id",
          "type": "string",
          "prompt": "What's your order number?",
          "default_from": "context.last_order_id",
          "optional": false
        },
        {
          "name": "requested_size",
          "type": "string",
          "prompt": "Which size would you like instead?",
          "default_from": null,
          "optional": false
        }
      ],
      "rules": [
        {
          "id": "exchange_window",
          "when": "result.days_since_delivery > 7",
          "deny": "Exchanges are only available within 7 days of delivery."
        }
      ],
      "confirm": true,
      "action": "create_exchange",
      "response": "Exchange booked for order {{order_id}} in size {{requested_size}}. Pickup is scheduled for {{result.pickup_date}}.",
      "receipt": {
        "label": "Exchange booked · {{result.exchange_ref}}",
        "tone": "info"
      }
    },
    {
      "id": "cancel_order",
      "description": "Cancel an order that has not yet been delivered.",
      "examples": [
        "cancel my order",
        "I don't want this order any more",
        "मेरा ऑर्डर कैंसल करो",
        "నా ఆర్డర్ రద్దు చేయండి",
        "என் ஆர்டரை ரத்து செய்"
      ],
      "required_inputs": [
        {
          "name": "order_id",
          "type": "string",
          "prompt": "What's your order number?",
          "default_from": "context.last_order_id",
          "optional": false
        }
      ],
      "rules": [
        {
          "id": "already_delivered",
          "when": "result.status == 'delivered'",
          "deny": "Order {{order_id}} has already been delivered, so it can't be cancelled. I can start a return instead."
        }
      ],
      "confirm": true,
      "action": "cancel_order",
      "response": "Done — order {{order_id}} is cancelled. Any amount paid is refunded within {{result.refund_eta_days}} days.",
      "receipt": {
        "label": "Cancelled · ref {{result.cancellation_ref}}",
        "tone": "warning"
      }
    }
  ],
  "endpoints": [
    {
      "id": "cancel_order",
      "method": "POST",
      "url": "{{mock_base}}/lakshmi-fashion/orders/{{order_id}}/cancel",
      "headers": {},
      "body": null,
      "timeout_s": 5
    },
    {
      "id": "create_exchange",
      "method": "POST",
      "url": "{{mock_base}}/lakshmi-fashion/orders/{{order_id}}/exchange",
      "headers": {},
      "body": null,
      "timeout_s": 5
    },
    {
      "id": "get_order",
      "method": "GET",
      "url": "{{mock_base}}/lakshmi-fashion/orders/{{order_id}}",
      "headers": {},
      "body": null,
      "timeout_s": 5
    }
  ],
  "knowledge": [
    {
      "id": "return_policy",
      "text": "Clothing can be returned or exchanged within 7 days if unworn and with original tags attached."
    },
    {
      "id": "exchange_policy",
      "text": "One free size exchange is allowed per order. Pickup is arranged within 48 hours."
    },
    {
      "id": "colour_note",
      "text": "Fabric colours may vary slightly from photographs because of screen differences."
    },
    {
      "id": "delivery",
      "text": "Orders ship within 2 working days and arrive in 4-6 days statewide."
    }
  ],
  "escalation": {
    "when": [
      "rule_denied",
      "action_failed",
      "user_asks_human"
    ],
    "message": "I'm handing this to a human agent from Lakshmi Fashion — they'll call you back within 2 hours.",
    "action": "create_escalation_ticket"
  }
}
