.env
stores.json

# Python
__pycache__/
*.pyc
venv/
.venv/
*.db
*.db-journal
*.db-shm
*.db-wal

# Node
node_modules/
dist/

# Test artifacts
Dashboard/frontend/test-results/
tests/test-results/
playwright-report/
.playwright/

# OS
.DS_Store

# E2E runs generate numbered duplicates (ravi-electronics-2.json, ...).
# Only hand-onboarded manifests belong in git.
# The trailing * matters: without it the pattern stops at a single digit and
# every run past the ninth leaks back into the repo.
manifests/*-[0-9]*.json
manifests/*-[0-9]*.protocol.json
